CATALANT_EMAIL=
CATALANT_PASSWORD=

SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy fallback only when SUPABASE_SECRET_KEY is absent:
SUPABASE_SERVICE_ROLE_KEY=

# Optional migration / CLI linking:
SUPABASE_PROJECT_REF=
SUPABASE_ACCESS_TOKEN=
SUPABASE_DB_PASSWORD=
SUPABASE_DB_URL=

SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=

RECIPIENT_EMAILS=

ERROR_RECIPIENTS=
ERROR_RECIPIENT=
ERROR_RECIPENT=
error_recipent=

ERROR_EMAIL_COOLDOWN_MINUTES=0
LOGIN_RETRY_INTERVAL=300
# Days before the same platform+project_id may create a new occurrence + email.
# OCCURRENCE_WINDOW_DAYS takes precedence over REPOST_MIN_DAYS when both are set.
OCCURRENCE_WINDOW_DAYS=3
REPOST_MIN_DAYS=3

EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BASE_MINUTES=15

HEADLESS=true
CHECK_INTERVAL=300

EVIDENCE_DIR=/tmp/catalant-evidence
EVIDENCE_RETENTION_HOURS=24

COOKIES_FILE=catalant_cookies.json

DETAIL_FETCH_DELAY_SECONDS=2
DETAIL_MAX_ATTEMPTS=2

# Chromium "tab crashed" recovery (full cycle retry with fresh driver)
TAB_CRASH_MAX_RETRIES=2
TAB_CRASH_RETRY_DELAY_SECONDS=60

# false = first process scan may email eligible projects.
# Empty-platform cold start ALWAYS seeds with emails suppressed (COLD_START_SEED).
# true = also seed first process scan with FIRST_RUN_SEED (no project emails).
SUPPRESS_PROJECT_EMAILS_ON_FIRST_SCAN=false

# Quit + reap Chromium and exit so start.sh relaunches (hours). 0 disables.
PROCESS_RECYCLE_HOURS=3
PROCESS_HARD_TIMEOUT_SECONDS=
PROCESS_RECYCLE_EXIT_CODE=75
WORKER_LOCK_PATH=

# Operational error email storm controls (0 = unlimited / every error emails).
# This monitor uses ERROR_EMAIL_COOLDOWN_MINUTES as the primary gate.
INCIDENT_CONSECUTIVE_FAILURE_THRESHOLD=1
INCIDENT_OPEN_AFTER_MINUTES=0
INCIDENT_REMINDER_HOURS=0
INCIDENT_MAX_EMAILS=0
INCIDENT_MAX_EMAILS_PER_PLATFORM_DAY=0
